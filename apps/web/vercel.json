{
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @wisdomly/web build",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://wisdomly-api.onrender.com/api/:path*"
    }
  ]
}
